# 本地版只监听当前电脑，不向局域网开放。
LOCAL_WEB_HOST=127.0.0.1
LOCAL_WEB_PORT=8768

# 只开放真正的本地数据盘；不要在这里加入 NAS 映射盘。
# 可用环境变量，例如：用户文档=%USERPROFILE%\Documents
MEDIA_ROOTS=本机D盘=D:\

# FFmpeg 路径可为绝对路径，或相对本项目根目录。
# 开发机可指向桌面转换工具；分发包使用 vendor\ffmpeg\...
FFMPEG_BIN=..\MediaConverter\ffmpeg\ffmpeg.exe
FFPROBE_BIN=..\MediaConverter\ffmpeg\ffprobe.exe